          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n    day::timestamp AS \"time\",\n    SUM(\n        CASE WHEN drift_detected THEN 1 ELSE 0 END\n    )::double precision AS \"Drifted features\"\nFROM daily_feature_drift\nWHERE $__timeFilter(day::timestamp)\nGROUP BY day\nORDER BY day;\n",
          "refId": "A",
